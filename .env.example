# Kalshi Demo API credentials — never point these at the production API.
KALSHI_API_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem
KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2

# Comma-separated Kalshi market tickers to subscribe to.
MARKET_TICKERS=KXBTC-24JUL2915,KXETH-24JUL2915

# Comma-separated Coinbase product symbols used as the crypto index proxy feed.
CRYPTO_FEED_SYMBOLS=BTC-USD,ETH-USD

# If true (default), DemoTrader never hits the network — it only simulates fills/phantom fills.
DRY_RUN=true

# Kill-switch: once simulated losses for the day reach this amount (USD), no further orders
# are placed until the process restarts (or the kill switch is reset).
MAX_DAILY_LOSS=100.0
